# --- Database (Supabase → Project Settings → Database → Connection string) ---
# Transaction pooler (port 6543) for the app:
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session / direct connection (port 5432) for migrations:
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Supabase Auth + Storage (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."        # server only, used for logo uploads
SUPABASE_LOGO_BUCKET="logos"

# Only this Google account may sign in (comma-separate to allow more than one)
OWNER_EMAIL="ndiaziii93@gmail.com"

# Set to "true" to run without sign-in (local development only)
AUTH_DISABLED="false"

# --- Claude research step ---
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-sonnet-5-5"
